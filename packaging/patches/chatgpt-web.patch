+def _profile_owner_by_scan(profile: Path) -> int | None:
+    """The same answer on macOS and Windows: the browser process (not a helper of it) started with this profile."""
+    import psutil
+
+    for proc in psutil.process_iter(["pid", "cmdline", "status"]):
+        try:
+            argv = proc.info["cmdline"] or []
+            if proc.info["status"] == psutil.STATUS_ZOMBIE or any(arg.startswith("--type=") for arg in argv):
+                continue
+            if any(_is_profile_flag(os.fsencode(arg), profile) for arg in argv):
+                return proc.info["pid"]
+        except (psutil.Error, OSError):  # gone since the listing, or not ours to look at
+            continue
+    return None
