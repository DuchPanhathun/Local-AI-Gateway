+def _own_group() -> dict[str, object]:
+    """Spawn options that make the CLI lead its own process group (POSIX: one killpg reaches the whole tree).
+
+    Windows has no such thing; there a new process group at least keeps Ctrl+C in the terminal from
+    reaching the CLI, which this gateway ends itself.
+    """
+    if IS_WINDOWS:
+        return {"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP}
+    return {"start_new_session": True}
+
+
+def _refuse_cmd_syntax(argv: list[str]) -> None:
+    if IS_WINDOWS and Path(argv[0]).suffix.lower() in (".cmd", ".bat"):
+        if any(_CMD_SYNTAX.search(arg) for arg in argv[1:]):
+            raise BadRequest(f"refusing to pass {Path(argv[0]).name} an argument cmd.exe would read as a command")
+
